{
    "name": "xratesapi/php-sdk",
    "description": "Official PHP SDK for the XRates exchange rate API — multi-source FX rates with a single REST endpoint.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "exchange-rate",
        "exchange-rate-api",
        "fx",
        "fx-rates",
        "currency",
        "currency-api",
        "currency-conversion",
        "xrates"
    ],
    "homepage": "https://xratesapi.com",
    "support": {
        "docs": "https://xratesapi.com/docs",
        "source": "https://github.com/xratesapi/php-sdk",
        "issues": "https://github.com/xratesapi/php-sdk/issues"
    },
    "authors": [
        {
            "name": "XRates Team",
            "homepage": "https://xratesapi.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "XRatesApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XRatesApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
